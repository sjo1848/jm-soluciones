---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="mb-9 max-w-3xl md:mb-10">
  {eyebrow && (
    <div class="electric-tag mb-3.5 inline-flex items-center gap-2.5 rounded-md px-3 py-1.5">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-3.5 text-[var(--color-electric)]">
        <path d="M13.25 2.2a.9.9 0 0 0-1.57.16L6.7 12.35a.9.9 0 0 0 .8 1.3h3.09L9.62 21a.9.9 0 0 0 1.65.55l6-10.35a.9.9 0 0 0-.78-1.35h-3.1l.87-6.76a.9.9 0 0 0-.99-.89Z" />
      </svg>
      <span class="h-[2px] w-9 bg-[var(--color-brand-soft)]"></span>
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--color-brand-soft)]">{eyebrow}</p>
    </div>
  )}
  <h2 class="text-3xl font-extrabold leading-[1.03] text-[var(--color-text)] md:text-[2.45rem]">{title}</h2>
  {description && <p class="mt-3.5 max-w-2xl text-base leading-relaxed text-[var(--color-text-muted)]">{description}</p>}
</header>
