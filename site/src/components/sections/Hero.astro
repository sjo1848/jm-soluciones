---
import { Image } from 'astro:assets';

interface Props {
  h1: string;
  descriptor: string;
  subtitle: string;
  mobileSubtitle?: string;
  locationLabel: string;
  responseTimeLabel: string;
  checks: string[];
  whatsappUrl: string;
  ctaLabel: string;
  topServiceLabel?: string;
  topServiceHref?: string;
  commercialNotice?: string;
  backgroundImage: ImageMetadata;
}

const {
  h1,
  descriptor,
  subtitle,
  mobileSubtitle = 'Electricidad para obras y refacciones en Gran Mendoza. Relevamiento y presupuesto por WhatsApp.',
  locationLabel,
  responseTimeLabel,
  checks,
  whatsappUrl,
  ctaLabel,
  topServiceLabel = 'Servicio más solicitado: Electricidad para Obras y Refacciones',
  topServiceHref = '/servicios/electricidad-para-obras-y-refacciones-mendoza',
  commercialNotice = 'Presupuesto, alcance y materiales definidos antes de ejecutar.',
  backgroundImage,
} = Astro.props;

const topServiceName = topServiceLabel.replace(/^Servicio m[aá]s solicitado:\s*/i, '');
const contactSteps = [
  'Indicá la zona y el tipo de trabajo.',
  'Adjuntá fotos o video si ya los tenés.',
  'Coordinamos relevamiento y presupuesto.',
];
---

<section class="hero-with-header-offset relative isolate overflow-hidden pb-14 md:pb-20">
  <Image
    src={backgroundImage}
    alt="Trabajo eléctrico realizado por JM Soluciones"
    widths={[640, 960, 1280, 1600]}
    sizes="(max-width: 768px) 100vw, 1600px"
    loading="eager"
    decoding="async"
    width={1600}
    class="absolute inset-0 -z-20 h-full w-full object-cover"
  />
  <div class="professional-hero-overlay absolute inset-0 -z-10"></div>

  <div class="container-shell grid gap-8 lg:grid-cols-[1.12fr_0.88fr] lg:items-center lg:gap-12">
    <div class="animate-on-scroll is-visible py-3 md:py-8">
      <p class="professional-eyebrow inline-flex items-center gap-2 rounded-full border border-sky-200/35 bg-sky-100/10 px-3 py-1.5 text-xs font-bold uppercase tracking-[0.12em] text-sky-100 backdrop-blur-sm">
        <span class="h-2 w-2 rounded-full bg-sky-300"></span>
        {descriptor}
      </p>

      <h1 class="professional-hero-title mt-5 text-[2.55rem] font-extrabold leading-[1.02] text-white sm:text-5xl md:text-6xl">
        {h1}
      </h1>

      <p class="professional-copy mt-5 text-base leading-relaxed text-slate-200 md:hidden">{mobileSubtitle}</p>
      <p class="professional-copy mt-5 hidden text-lg leading-relaxed text-slate-200 md:block lg:text-xl">{subtitle}</p>

      <div class="mt-6 flex flex-wrap gap-x-5 gap-y-3 text-sm font-semibold text-slate-100">
        <span class="inline-flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-sky-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          {locationLabel}
        </span>
        <span class="inline-flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          {responseTimeLabel}
        </span>
      </div>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noreferrer"
          class="electric-cta inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-[var(--color-whatsapp)] px-6 py-3.5 text-sm font-bold text-white transition hover:bg-[var(--color-whatsapp-hover)] md:px-7 md:text-base"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.868-2.03-.967-.272-.099-.47-.148-.668.148-.198.297-.767.967-.94 1.165-.173.198-.346.223-.643.074-.297-.149-1.255-.463-2.39-1.475-.882-.788-1.478-1.761-1.65-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.496.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.463 1.065 2.876 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.569-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.82 9.82 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.82 11.82 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.88 11.88 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.8 11.8 0 0 0-3.48-8.413z"/></svg>
          {ctaLabel}
        </a>
        <a
          href="#trabajos"
          class="professional-secondary-cta inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border border-white/35 px-6 py-3.5 text-sm font-bold text-white transition md:text-base"
        >
          Ver trabajos realizados
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      </div>

      <ul class="mt-7 grid gap-2 text-sm font-medium text-slate-100 sm:grid-cols-2">
        {checks.map((check) => (
          <li class="flex items-start gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-4 w-4 shrink-0 text-emerald-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>{check}</span>
          </li>
        ))}
      </ul>

      <p class="mt-5 text-xs font-semibold text-slate-300">{commercialNotice}</p>
    </div>

    <aside class="professional-proof-card animate-on-scroll is-visible delay-100 rounded-2xl border border-white/45 bg-white/95 p-6 text-slate-900 backdrop-blur-md md:p-8">
      <p class="inline-flex rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-extrabold uppercase tracking-[0.1em] text-emerald-800">
        Consulta inicial simple
      </p>
      <h2 class="mt-4 text-2xl font-extrabold leading-tight text-slate-900 md:text-3xl">
        Contanos qué necesitás y coordinamos el próximo paso.
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-slate-600 md:text-base">
        No necesitás conocer términos técnicos. Con algunos datos podemos orientarte antes de programar la visita.
      </p>

      <ol class="mt-6 grid gap-4">
        {contactSteps.map((step, index) => (
          <li class="flex items-start gap-3">
            <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-900 text-sm font-extrabold text-white">{index + 1}</span>
            <span class="pt-1 text-sm font-semibold leading-relaxed text-slate-700">{step}</span>
          </li>
        ))}
      </ol>

      <div class="mt-7 grid grid-cols-2 gap-3 border-t border-slate-200 pt-5">
        <div>
          <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-slate-500">Servicio principal</p>
          <p class="mt-1 text-sm font-extrabold leading-snug text-slate-900">{topServiceName}</p>
        </div>
        <div>
          <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-slate-500">Cobertura</p>
          <p class="mt-1 text-sm font-extrabold text-slate-900">Gran Mendoza</p>
        </div>
      </div>

      <a href={topServiceHref} class="mt-5 inline-flex items-center gap-2 text-sm font-extrabold text-sky-800 transition hover:text-sky-950">
        Conocer el alcance del servicio principal
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
      </a>
    </aside>
  </div>
</section>
