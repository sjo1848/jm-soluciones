---
import SectionTitle from '../ui/SectionTitle.astro';
import { Image } from 'astro:assets';
import type { WorkGalleryCategory } from '../../content/types';

interface Props {
  categories: WorkGalleryCategory[];
  instagramUrl?: string;
}

const { categories } = Astro.props;
const initialAllLimit = 9;
const initialCategoryLimit = 6;

const galleryEntries = categories.flatMap((category) =>
  category.images.map((image, categoryIndex) => ({
    ...image,
    categoryId: category.id,
    categoryTitle: category.title,
    categoryIndex,
  })),
);

const localImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/**/*.{jpeg,jpg,png,gif,webp}', { eager: true });

const getImageMetadata = (srcPath: string) => {
  const filename = srcPath.split('/').pop();
  if (!filename) return null;
  const match = Object.keys(localImages).find((path) => path.endsWith('/' + filename));
  return match ? localImages[match].default : null;
};

const isRemoteImage = (srcPath: string) => /^https?:\/\//.test(srcPath);
---

<section class="py-16 md:py-18" id="trabajos">
  <div class="container-shell">
    <SectionTitle
      eyebrow="Trabajos reales"
      title="Una selección de instalaciones realizadas"
      description="Mostramos primero los trabajos más representativos. Podés filtrar por tipo de instalación o ampliar la galería cuando necesites más detalle."
    />

    <div class="gallery-filter-shell mb-8 rounded-[1.5rem] border border-[var(--color-border)] bg-[var(--color-surface)]/88 p-4 shadow-sm md:mb-10 md:p-5">
      <div class="flex flex-wrap gap-2.5" aria-label="Filtrar trabajos por categoría">
        <button
          type="button"
          class="js-gallery-filter gallery-filter is-active"
          data-gallery-filter="all"
          aria-pressed="true"
        >
          <span>Selección general</span>
          <span class="gallery-filter-count">{galleryEntries.length}</span>
        </button>
        {categories.map((category) => (
          <button
            type="button"
            class="js-gallery-filter gallery-filter"
            data-gallery-filter={category.id}
            aria-pressed="false"
          >
            <span>{category.title}</span>
            <span class="gallery-filter-count">{category.images.length}</span>
          </button>
        ))}
      </div>

      <div class="mt-4 border-t border-[var(--color-border)] pt-4 md:mt-5 md:pt-5">
        <div class="js-gallery-summary" data-gallery-summary="all">
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--color-brand-soft)]">Vista general</p>
          <h3 class="mt-2 text-xl font-extrabold text-[var(--color-text)] md:text-2xl">Obras, refacciones, tableros e iluminación</h3>
          <p class="mt-2 max-w-3xl text-sm leading-relaxed text-[var(--color-text-muted)] md:text-base">
            Una muestra breve para comprobar el tipo de terminación, escala y variedad de trabajos.
          </p>
        </div>

        {categories.map((category) => (
          <div class="js-gallery-summary" data-gallery-summary={category.id} hidden>
            <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--color-brand-soft)]">Categoría seleccionada</p>
            <h3 class="mt-2 text-xl font-extrabold text-[var(--color-text)] md:text-2xl">{category.title}</h3>
            <p class="mt-2 max-w-3xl text-sm leading-relaxed text-[var(--color-text-muted)] md:text-base">{category.description}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3" id="gallery-grid">
      {galleryEntries.map((image, index) => {
        const metadata = getImageMetadata(image.src);

        return (
          <figure
            class="js-gallery-card electric-card overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-sm"
            data-gallery-item={image.categoryId}
            data-gallery-all-index={index}
            data-gallery-category-index={image.categoryIndex}
            hidden={index >= initialAllLimit}
          >
            <button
              type="button"
              class="group relative block w-full overflow-hidden text-left"
              data-lightbox-open={`lightbox-${index}`}
              aria-label={`Abrir imagen: ${image.alt}`}
            >
              {isRemoteImage(image.src) ? (
                <img
                  src={image.src}
                  alt={image.alt}
                  loading="lazy"
                  decoding="async"
                  width="600"
                  referrerpolicy="no-referrer"
                  class="js-gallery-image h-72 w-full object-cover transition-transform duration-300 group-hover:scale-[1.03] md:h-80"
                />
              ) : metadata ? (
                <img
                  src={metadata.src}
                  alt={image.alt}
                  loading="lazy"
                  decoding="async"
                  width="600"
                  class="js-gallery-image h-72 w-full object-cover transition-transform duration-300 group-hover:scale-[1.03] md:h-80"
                />
              ) : (
                <img
                  src="/images/placeholder-work.svg"
                  alt={image.alt}
                  loading="lazy"
                  decoding="async"
                  width="600"
                  data-fallback-src="/images/placeholder-work.svg"
                  class="js-gallery-image h-72 w-full object-cover transition-transform duration-300 group-hover:scale-[1.03] md:h-80"
                />
              )}
              <span class="gallery-card-badge pointer-events-none absolute left-4 top-4 inline-flex rounded-full px-3 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-white">
                {image.categoryTitle}
              </span>
              <span class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/72 via-black/18 to-transparent"></span>
              <span class="pointer-events-none absolute bottom-4 left-4 right-4 text-sm font-bold text-white md:text-base">
                {image.alt}
              </span>
            </button>
          </figure>
        );
      })}
    </div>

    <div class="mt-8 flex justify-center">
      <button
        id="gallery-toggle"
        type="button"
        data-expanded="false"
        data-all-limit={initialAllLimit}
        data-category-limit={initialCategoryLimit}
        class="electric-cta-secondary inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] px-5 py-3 text-sm font-extrabold text-[var(--color-text)] transition hover:border-[var(--color-brand-soft)]"
        aria-controls="gallery-grid"
        aria-expanded="false"
      >
        <span data-gallery-toggle-label>Ver más trabajos</span>
        <svg data-gallery-toggle-icon xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
      </button>
    </div>
  </div>
</section>

{galleryEntries.map((image, index) => {
  const metadata = getImageMetadata(image.src);
  return (
    <dialog
      id={`lightbox-${index}`}
      class="js-lightbox-dialog m-auto max-h-[95vh] max-w-[95vw] border-0 bg-transparent p-0 outline-none"
    >
      <div class="relative flex h-full w-full flex-col items-center justify-center p-4">
        <button
          type="button"
          data-lightbox-close={`lightbox-${index}`}
          class="absolute right-2 top-2 cursor-pointer rounded-full bg-black/65 p-2 text-white/90 transition-colors hover:text-white md:-right-12 md:top-0"
          aria-label="Cerrar imagen ampliada"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="size-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>

        {isRemoteImage(image.src) ? (
          <img src={image.src} alt={image.alt} referrerpolicy="no-referrer" class="max-h-[85vh] w-auto max-w-full rounded-[1.25rem] border border-white/15 object-contain" />
        ) : metadata ? (
          <Image src={metadata} alt={image.alt} width={1200} class="max-h-[85vh] w-auto max-w-full rounded-[1.25rem] border border-white/15 object-contain" />
        ) : (
          <img src="/images/placeholder-work.svg" alt={image.alt} class="max-h-[85vh] w-auto max-w-full rounded-[1.25rem] border border-white/15 object-contain" />
        )}
        <p class="mt-4 max-w-2xl px-4 text-center text-sm font-medium text-white md:text-base">{image.alt}</p>
      </div>
    </dialog>
  );
})}

<script is:inline>
  (() => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const filterButtons = Array.from(document.querySelectorAll('.js-gallery-filter'));
    const cards = Array.from(document.querySelectorAll('.js-gallery-card'));
    const summaries = Array.from(document.querySelectorAll('.js-gallery-summary'));
    const toggleButton = document.getElementById('gallery-toggle');
    const toggleLabel = toggleButton?.querySelector('[data-gallery-toggle-label]');
    const toggleIcon = toggleButton?.querySelector('[data-gallery-toggle-icon]');
    let activeFilter = 'all';
    let expanded = false;

    const getLimit = () => {
      if (!(toggleButton instanceof HTMLElement)) return 9;
      const raw = activeFilter === 'all' ? toggleButton.dataset.allLimit : toggleButton.dataset.categoryLimit;
      return Number(raw ?? 9);
    };

    const applyGalleryState = () => {
      const limit = getLimit();
      const matchingCards = cards.filter((card) =>
        card instanceof HTMLElement && (activeFilter === 'all' || card.dataset.galleryItem === activeFilter)
      );

      cards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;
        const matchesFilter = activeFilter === 'all' || card.dataset.galleryItem === activeFilter;
        const rawIndex = activeFilter === 'all' ? card.dataset.galleryAllIndex : card.dataset.galleryCategoryIndex;
        const itemIndex = Number(rawIndex ?? 0);
        card.hidden = !matchesFilter || (!expanded && itemIndex >= limit);
      });

      filterButtons.forEach((button) => {
        if (!(button instanceof HTMLElement)) return;
        const isActive = button.dataset.galleryFilter === activeFilter;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });

      summaries.forEach((summary) => {
        if (!(summary instanceof HTMLElement)) return;
        summary.hidden = summary.dataset.gallerySummary !== activeFilter;
      });

      if (toggleButton instanceof HTMLButtonElement) {
        const canExpand = matchingCards.length > limit;
        toggleButton.hidden = !canExpand;
        toggleButton.dataset.expanded = expanded ? 'true' : 'false';
        toggleButton.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      }
      if (toggleLabel) toggleLabel.textContent = expanded ? 'Mostrar menos' : 'Ver más trabajos';
      toggleIcon?.classList.toggle('rotate-180', expanded);
    };

    const closeDialog = (dialog) => {
      if (!(dialog instanceof HTMLDialogElement)) return;
      dialog.classList.remove('is-visible');
      if (prefersReducedMotion) {
        dialog.close();
      } else {
        window.setTimeout(() => dialog.open && dialog.close(), 180);
      }
    };

    document.querySelectorAll('.js-gallery-image').forEach((image) => {
      image.addEventListener('error', () => {
        const fallback = image.getAttribute('data-fallback-src');
        if (fallback && image.getAttribute('src') !== fallback) image.setAttribute('src', fallback);
      });
    });

    document.querySelectorAll('.js-lightbox-dialog').forEach((dialog) => {
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) closeDialog(dialog);
      });
      dialog.addEventListener('cancel', (event) => {
        event.preventDefault();
        closeDialog(dialog);
      });
      dialog.addEventListener('close', () => dialog.classList.remove('is-visible'));
    });

    document.querySelectorAll('[data-lightbox-open]').forEach((button) => {
      button.addEventListener('click', () => {
        const dialogId = button instanceof HTMLElement ? button.dataset.lightboxOpen : null;
        const dialog = dialogId ? document.getElementById(dialogId) : null;
        if (!(dialog instanceof HTMLDialogElement)) return;
        dialog.showModal();
        if (prefersReducedMotion) dialog.classList.add('is-visible');
        else requestAnimationFrame(() => dialog.classList.add('is-visible'));
      });
    });

    document.querySelectorAll('[data-lightbox-close]').forEach((button) => {
      button.addEventListener('click', () => {
        const dialogId = button instanceof HTMLElement ? button.dataset.lightboxClose : null;
        closeDialog(dialogId ? document.getElementById(dialogId) : null);
      });
    });

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (!(button instanceof HTMLElement)) return;
        activeFilter = button.dataset.galleryFilter ?? 'all';
        expanded = false;
        applyGalleryState();
      });
    });

    toggleButton?.addEventListener('click', () => {
      expanded = !expanded;
      applyGalleryState();
    });

    const requestedFilter = new URLSearchParams(window.location.search).get('gallery');
    const availableFilters = new Set(
      filterButtons
        .map((button) => (button instanceof HTMLElement ? button.dataset.galleryFilter ?? '' : ''))
        .filter(Boolean),
    );
    activeFilter = requestedFilter && availableFilters.has(requestedFilter) ? requestedFilter : 'all';
    applyGalleryState();
  })();
</script>
