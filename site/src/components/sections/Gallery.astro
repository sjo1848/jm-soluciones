---
import SectionTitle from '../ui/SectionTitle.astro';
import { Image } from 'astro:assets';
import type { WorkGalleryCategory } from '../../content/types';

interface Props {
  categories: WorkGalleryCategory[];
  instagramUrl?: string;
}

const { categories } = Astro.props;
// Reactivar cuando el perfil tenga contenido publicado nuevamente.
// const { categories, instagramUrl = '' } = Astro.props;

const galleryEntries = categories.flatMap((category) =>
  category.images.map((image) => ({
    ...image,
    categoryId: category.id,
    categoryTitle: category.title,
  }))
);

const localImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/**/*.{jpeg,jpg,png,gif,webp}', { eager: true });

const getImageMetadata = (srcPath: string) => {
  const filename = srcPath.split('/').pop();
  if (!filename) return null;
  const match = Object.keys(localImages).find((path) => path.endsWith('/' + filename));
  return match ? localImages[match].default : null;
};

const isRemoteImage = (srcPath: string) => /^https?:\/\//.test(srcPath);
---

<section class="py-16 md:py-18" id="trabajos">
  <div class="container-shell">
    <SectionTitle
      eyebrow="Trabajos"
      title="Trabajos reales por tipo de instalacion"
      description="Ordenamos los registros por rubro para que puedas ver rapido el tipo de obra que resolvemos."
    />

    <div class="gallery-filter-shell mb-8 rounded-[1.75rem] border border-[var(--color-border)] bg-[var(--color-surface)]/85 p-4 shadow-sm md:mb-10 md:p-5">
      <div class="flex flex-wrap gap-2.5">
        <button
          type="button"
          class="js-gallery-filter gallery-filter is-active"
          data-gallery-filter="all"
          aria-pressed="true"
        >
          <span>Todos los trabajos</span>
          <span class="gallery-filter-count">{galleryEntries.length}</span>
        </button>
        {categories.map((category) => (
          <button
            type="button"
            class="js-gallery-filter gallery-filter"
            data-gallery-filter={category.id}
            aria-pressed="false"
          >
            <span>{category.title}</span>
            <span class="gallery-filter-count">{category.images.length}</span>
          </button>
        ))}
      </div>

      <div class="mt-4 md:mt-5">
        <div class="gallery-summary-panel js-gallery-summary" data-gallery-summary="all">
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--color-brand-soft)]">Galeria curada</p>
          <h3 class="mt-2 text-2xl font-extrabold text-[var(--color-text)]">Trabajos separados por tipo de instalacion</h3>
          <p class="mt-2 max-w-3xl text-sm leading-relaxed text-[var(--color-text-muted)] md:text-base">
            Dejamos atras la galeria mezclada y repetida. Ahora el material se muestra por rubro para que el recorrido sea mas claro y profesional.
          </p>
        </div>

        {categories.map((category) => (
          <div class="gallery-summary-panel js-gallery-summary" data-gallery-summary={category.id} hidden>
            <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--color-brand-soft)]">Categoria activa</p>
            <h3 class="mt-2 text-2xl font-extrabold text-[var(--color-text)]">{category.title}</h3>
            <p class="mt-2 max-w-3xl text-sm leading-relaxed text-[var(--color-text-muted)] md:text-base">{category.description}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {galleryEntries.map((image, index) => {
        const metadata = getImageMetadata(image.src);

        return (
          <figure
            class="js-gallery-card electric-card overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-sm"
            data-gallery-item={image.categoryId}
          >
            <button
              type="button"
              class="group relative block w-full overflow-hidden text-left"
              data-lightbox-open={`lightbox-${index}`}
              aria-label={`Abrir imagen: ${image.alt}`}
            >
              {isRemoteImage(image.src) ? (
                <img
                  src={image.src}
                  alt={image.alt}
                  loading="lazy"
                  decoding="async"
                  width="600"
                  referrerpolicy="no-referrer"
                  class="js-gallery-image h-72 w-full object-cover transition-transform duration-300 group-hover:scale-[1.03] md:h-80"
                />
              ) : metadata ? (
                <img
                  src={metadata.src}
                  alt={image.alt}
                  loading="lazy"
                  decoding="async"
                  width="600"
                  class="js-gallery-image h-72 w-full object-cover transition-transform duration-300 group-hover:scale-[1.03] md:h-80"
                />
              ) : (
                <img
                  src="/images/placeholder-work.svg"
                  alt={image.alt}
                  loading="lazy"
                  decoding="async"
                  width="600"
                  data-fallback-src="/images/placeholder-work.svg"
                  class="js-gallery-image h-72 w-full object-cover transition-transform duration-300 group-hover:scale-[1.03] md:h-80"
                />
              )}
              <span class="gallery-card-badge pointer-events-none absolute left-4 top-4 inline-flex rounded-full px-3 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-white">
                {image.categoryTitle}
              </span>
              <span class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/72 via-black/18 to-transparent"></span>
              <span class="pointer-events-none absolute bottom-4 left-4 right-4 text-sm font-bold text-white md:text-base">
                {image.alt}
              </span>
            </button>
          </figure>
        );
      })}
    </div>

    {/* Reactivar bloque de Instagram cuando haya contenido publicado y estrategia social activa. */}
  </div>
</section>

{galleryEntries.map((image, index) => {
  const metadata = getImageMetadata(image.src);
  return (
    <dialog
      id={`lightbox-${index}`}
      class="js-lightbox-dialog m-auto max-h-[95vh] max-w-[95vw] border-0 bg-transparent p-0 outline-none"
    >
      <div class="js-lightbox-panel relative flex h-full w-full flex-col items-center justify-center p-4">
        <button
          type="button"
          data-lightbox-close={`lightbox-${index}`}
          class="absolute right-2 top-2 cursor-pointer rounded-full bg-black/65 p-2 text-white/90 transition-colors hover:text-white md:-right-12 md:top-0"
          aria-label="Cerrar imagen ampliada"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="size-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>

        {isRemoteImage(image.src) ? (
          <img
            src={image.src}
            alt={image.alt}
            referrerpolicy="no-referrer"
            class="js-lightbox-media max-h-[85vh] w-auto max-w-full rounded-[1.25rem] border border-white/15 object-contain"
          />
        ) : metadata ? (
          <Image
            src={metadata}
            alt={image.alt}
            width={1200}
            class="js-lightbox-media max-h-[85vh] w-auto max-w-full rounded-[1.25rem] border border-white/15 object-contain"
          />
        ) : (
          <img
            src="/images/placeholder-work.svg"
            alt={image.alt}
            class="js-lightbox-media max-h-[85vh] w-auto max-w-full rounded-[1.25rem] border border-white/15 object-contain"
          />
        )}
        <p class="js-lightbox-caption mt-4 max-w-2xl px-4 text-center text-sm font-medium text-white md:text-base">{image.alt}</p>
      </div>
    </dialog>
  );
})}

<script is:inline>
  (() => {
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const galleryFilterButtons = Array.from(document.querySelectorAll('.js-gallery-filter'));
  const galleryCards = Array.from(document.querySelectorAll('.js-gallery-card'));
  const gallerySummaries = Array.from(document.querySelectorAll('.js-gallery-summary'));

  const setGalleryFilter = (filterId) => {
    galleryFilterButtons.forEach((button) => {
      if (!(button instanceof HTMLElement)) return;
      const isActive = button.dataset.galleryFilter === filterId;
      button.classList.toggle('is-active', isActive);
      button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });

    galleryCards.forEach((card) => {
      if (!(card instanceof HTMLElement)) return;
      const categoryId = card.dataset.galleryItem;
      const isVisible = filterId === 'all' || categoryId === filterId;
      card.hidden = !isVisible;
    });

    gallerySummaries.forEach((summary) => {
      if (!(summary instanceof HTMLElement)) return;
      summary.hidden = summary.dataset.gallerySummary !== filterId;
    });
  };

  const openDialogWithAnimation = (dialog) => {
    if (!(dialog instanceof HTMLDialogElement)) return;
    if (!dialog.open) {
      dialog.showModal();
    }
    if (prefersReducedMotion) {
      dialog.classList.add('is-visible');
      return;
    }
    requestAnimationFrame(() => {
      dialog.classList.add('is-visible');
    });
  };

  const closeDialogWithAnimation = (dialog) => {
    if (!(dialog instanceof HTMLDialogElement)) return;
    if (prefersReducedMotion) {
      dialog.close();
      dialog.classList.remove('is-visible');
      return;
    }

    dialog.classList.remove('is-visible');
    window.setTimeout(() => {
      if (dialog.open) dialog.close();
    }, 180);
  };

  document.querySelectorAll('.js-gallery-image').forEach((image) => {
    image.addEventListener('error', () => {
      const fallback = image.getAttribute('data-fallback-src');
      if (fallback && image.getAttribute('src') !== fallback) {
        image.setAttribute('src', fallback);
      }
    });
  });

  document.querySelectorAll('.js-lightbox-dialog').forEach((dialog) => {
    dialog.addEventListener('click', (ev) => {
      if (ev.target === dialog) {
        closeDialogWithAnimation(dialog);
      }
    });

    dialog.addEventListener('cancel', (ev) => {
      ev.preventDefault();
      closeDialogWithAnimation(dialog);
    });

    dialog.addEventListener('close', () => {
      dialog.classList.remove('is-visible');
    });
  });

  document.querySelectorAll('[data-lightbox-open]').forEach((button) => {
    button.addEventListener('click', () => {
      const dialogId = button instanceof HTMLElement ? button.dataset.lightboxOpen : null;
      const dialog = dialogId ? document.getElementById(dialogId) : null;
      openDialogWithAnimation(dialog);
    });
  });

  document.querySelectorAll('[data-lightbox-close]').forEach((button) => {
    button.addEventListener('click', () => {
      const dialogId = button instanceof HTMLElement ? button.dataset.lightboxClose : null;
      const dialog = dialogId ? document.getElementById(dialogId) : null;
      closeDialogWithAnimation(dialog);
    });
  });

  galleryFilterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      if (!(button instanceof HTMLElement)) return;
      const filterId = button.dataset.galleryFilter ?? 'all';
      setGalleryFilter(filterId);
    });
  });

  const requestedFilter = new URLSearchParams(window.location.search).get('gallery');
  const availableFilters = new Set(
    galleryFilterButtons
      .map((button) => (button instanceof HTMLElement ? button.dataset.galleryFilter ?? '' : ''))
      .filter(Boolean)
  );

  setGalleryFilter(requestedFilter && availableFilters.has(requestedFilter) ? requestedFilter : 'all');
  })();
</script>
