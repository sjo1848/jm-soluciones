---
import SectionTitle from '../ui/SectionTitle.astro';
import type { ProcessStep } from '../../content/types';

interface Props {
  steps: ProcessStep[];
}

const { steps } = Astro.props;
---

<section class="py-16 md:py-18" id="proceso">
  <div class="container-shell">
    <SectionTitle
      eyebrow="Coordinacion del trabajo"
      title="Como relevamos, presupuestamos y ejecutamos cada trabajo electrico"
      description="Un proceso claro para obras, refacciones, ampliaciones y trabajos por etapa."
    />
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {steps.map((item) => (
        <article class="electric-card rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 transition-colors hover:border-[var(--color-brand-soft)]/40">
          <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-[var(--color-brand-soft)]">{item.step}</p>
          <h3 class="mt-3 text-base font-extrabold text-[var(--color-text)]">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
