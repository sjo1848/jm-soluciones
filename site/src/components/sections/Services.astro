---
import SectionTitle from '../ui/SectionTitle.astro';
import type { ServiceDetail } from '../../content/types';
import { buildWhatsAppUrl } from '../../utils/whatsapp';

interface Props {
  services: ServiceDetail[];
  whatsappPhone: string;
  ctaLabel: string;
}

const { services, whatsappPhone, ctaLabel } = Astro.props;

const topServiceSlug = 'electricidad-para-obras-y-refacciones-mendoza';
const featuredService = services.find((service) => service.slug === topServiceSlug) ?? services[0];
const secondaryServices = services.filter((service) => service.slug !== featuredService.slug);
const featuredWhatsAppUrl = buildWhatsAppUrl(whatsappPhone, featuredService.whatsappMessage, 'servicios');
const generalWhatsAppUrl = buildWhatsAppUrl(
  whatsappPhone,
  'Hola, __JM_SALUDO__ no se que servicio corresponde para mi obra o refaccion.\nZona: [barrio/ciudad]\nTipo de trabajo: [obra/refaccion/instalacion]\nDetalle: [detalle]',
  'servicios'
);
---

<section class="py-16 md:py-18" id="servicios">
  <div class="container-shell">
    <SectionTitle
      eyebrow="Servicios"
      title="Servicios mas pedidos"
      description="Elegi el tipo de trabajo o escribinos si todavia estas definiendo el alcance."
    />

    <article class="electric-card animate-on-scroll panel mb-8 overflow-hidden p-6 md:p-8">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-brand-soft)]">Servicio principal para obras y refacciones</p>
      <div class="mt-3 grid gap-6 md:grid-cols-[1.1fr_0.9fr] md:items-center">
        <div>
          <h3 class="text-3xl font-extrabold leading-[1] text-[var(--color-text)] md:text-4xl">{featuredService.title}</h3>
          <p class="mt-3 line-clamp-2 text-[var(--color-text-muted)]">{featuredService.description}</p>
          <ul class="mt-4 grid gap-2 text-sm text-[var(--color-text-muted)] sm:grid-cols-2">
            {featuredService.features.slice(0, 3).map((feature: string) => (
              <li class="flex items-start gap-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-soft)]/70 px-3 py-2">
                <span class="mt-1 inline-block h-2 w-2 rounded-full bg-[var(--color-brand-soft)]"></span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
          {featuredService.commonJobs?.length ? (
            <div class="mt-5">
              <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--color-brand-soft)]">Trabajos frecuentes</p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {featuredService.commonJobs.map((job: string) => (
                  <li class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface-soft)] px-3 py-1.5 text-xs font-semibold text-[var(--color-text)]">
                    {job}
                  </li>
                ))}
              </ul>
            </div>
          ) : null}
        </div>

        <div class="flex flex-col gap-3">
          <a
            href={featuredWhatsAppUrl}
            target="_blank"
            rel="noreferrer"
            class="electric-cta inline-flex items-center justify-center gap-2 rounded-xl bg-[var(--color-whatsapp)] px-6 py-3 text-sm font-bold text-white transition hover:bg-[var(--color-whatsapp-hover)]"
          >
            Pedir presupuesto de este servicio
          </a>
          <a
            href={`/servicios/${featuredService.slug}`}
            class="electric-cta-secondary inline-flex items-center justify-center gap-2 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-soft)] px-6 py-3 text-sm font-bold text-[var(--color-text)] transition hover:border-[var(--color-brand-soft)]"
          >
            Ver alcance del servicio
          </a>
          <p class="text-center text-xs font-medium leading-relaxed text-[var(--color-text-muted)]">
            Si todavia estas definiendo el alcance, escribinos y te orientamos por WhatsApp.
          </p>
        </div>
      </div>
    </article>

    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {secondaryServices.map((service, index) => (
        <article
          class:list={[
            'electric-card animate-on-scroll rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 transition-all duration-200 hover:-translate-y-1 hover:border-[var(--color-brand-soft)]/40 hover:shadow-[var(--shadow-card-hover)]',
            `delay-${(index % 3) * 100}`
          ]}
        >
          <h3 class="text-2xl font-extrabold leading-[1.05] text-[var(--color-text)]">{service.title}</h3>
          <ul class="mt-4 space-y-2 text-sm text-[var(--color-text-muted)]">
            {service.features.slice(0, 3).map((feature: string) => (
              <li class="flex gap-2">
                <span class="mt-1 inline-block h-2 w-2 rounded-full bg-[var(--color-brand-soft)]"></span>
                <span class="line-clamp-1">{feature}</span>
              </li>
            ))}
          </ul>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href={buildWhatsAppUrl(whatsappPhone, service.whatsappMessage, 'servicios')}
              target="_blank"
              rel="noreferrer"
              class="inline-flex min-h-10 items-center rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-soft)] px-3 py-2 text-sm font-bold text-[var(--color-text)] transition hover:border-[var(--color-brand-soft)]"
            >
              Pedir presupuesto
            </a>
            <a
              href={`/servicios/${service.slug}`}
              class="inline-flex min-h-10 items-center gap-2 rounded-lg px-3 py-2 text-sm font-bold text-[var(--color-brand-soft)]"
            >
              Ver alcance
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.3" stroke="currentColor" class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-8">
      <a
        href={generalWhatsAppUrl}
        target="_blank"
        rel="noreferrer"
        class="electric-cta inline-flex rounded-xl bg-[var(--color-whatsapp)] px-6 py-3 text-sm font-extrabold text-white transition hover:bg-[var(--color-whatsapp-hover)] md:text-base"
      >
        {ctaLabel}
      </a>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-[var(--color-text-muted)]">
        Si todavia no tenes claro el servicio exacto, mandanos zona, tipo de trabajo y necesidad. Te orientamos antes de coordinar la visita.
      </p>
    </div>
  </div>
</section>
