---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/sections/Header.astro';
import Footer from '../../components/sections/Footer.astro';
import FloatingWhatsapp from '../../components/sections/FloatingWhatsapp.astro';
import MobileActionBar from '../../components/sections/MobileActionBar.astro';
import { landingContent } from '../../content/landing';
import { buildWhatsAppUrl } from '../../utils/whatsapp';
import { buildLocalZonePageSchema } from '../../utils/seo';

export async function getStaticPaths() {
  return landingContent.localZones.map((zone) => ({
    params: { slug: zone.slug },
    props: { zone },
  }));
}

const { zone } = Astro.props;

const zoneWhatsappUrl = buildWhatsAppUrl(
  landingContent.contact.whatsapp,
  landingContent.cta.whatsappMessage,
  'zona'
);

const siteUrl = import.meta.env.PUBLIC_SITE_URL;
const canonical = siteUrl ? new URL(Astro.url.pathname, siteUrl).toString() : Astro.url.toString();
const schema = buildLocalZonePageSchema(landingContent, zone, new URL(canonical), zoneWhatsappUrl);

const zoneTitle = `Electricista en ${zone.name} | JM Soluciones Electricas`;
const zoneDescription = `${zone.description} Presupuesto por WhatsApp.`;
const otherZones = landingContent.localZones.filter((item) => item.slug !== zone.slug);
---

<BaseLayout
  title={zoneTitle}
  description={zoneDescription}
  keywords={landingContent.seo.keywords + `, electricista ${zone.name.toLowerCase()}`}
  canonical={canonical}
  schema={schema}
>
  <Header brandName={landingContent.brand.name} />

  <section class="main-with-header-offset flex-grow pb-16">
    <div class="container-shell">
      <div class="mx-auto max-w-3xl text-center">
        <p class="mb-4 text-xs font-extrabold uppercase tracking-[0.16em] text-[var(--color-brand-soft)]">Cobertura en {zone.name}</p>
        <h1 class="mb-6 text-4xl font-extrabold tracking-tight text-[var(--color-text)] text-pretty md:text-5xl">
          Electricidad para obras y refacciones en {zone.name}
        </h1>
        <p class="text-pretty text-lg leading-relaxed text-[var(--color-text-muted)] md:text-xl">
          {zone.description}
        </p>
        <div class="mt-5 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] px-5 py-4 text-left">
          <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-[var(--color-brand-soft)]">Cobertura operativa</p>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)] md:text-base">
            {zone.coverageNote}
          </p>
        </div>
        <ul class="mt-5 grid gap-3 sm:grid-cols-3">
          {landingContent.servicesDetails.map((service) => (
            <li class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-soft)] px-4 py-3 text-sm font-semibold text-[var(--color-text)]">
              {service.title}
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-14 grid items-start gap-8 rounded-3xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 md:p-10">
        <div>
          <h2 class="mb-6 text-2xl font-bold text-[var(--color-text)]">Servicios disponibles en {zone.name}</h2>
          <ul class="space-y-4">
            {landingContent.servicesDetails.map((service) => (
              <li class="flex items-start gap-3 text-[var(--color-text-muted)]">
                <span class="mt-1 shrink-0 rounded-full bg-[var(--color-whatsapp)]/18 p-1 text-[var(--color-whatsapp)]">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="size-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                  </svg>
                </span>
                <span class="flex flex-wrap items-center gap-2">
                  <a
                    href={`/servicios/${service.slug}`}
                    class="font-bold text-[var(--color-brand-soft)] hover:underline"
                  >
                    {service.title}
                  </a>
                  <span class="text-sm">{service.description}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-10">
          <p class="mb-4 text-sm leading-relaxed text-[var(--color-text-muted)]">
            Mandanos zona, tipo de trabajo y detalle por WhatsApp. Te orientamos y coordinamos una visita si hace falta relevamiento.
          </p>
          <a
            href={zoneWhatsappUrl}
            target="_blank"
            rel="noreferrer"
            class="electric-cta inline-flex items-center gap-2 rounded-xl bg-[var(--color-whatsapp)] px-8 py-4 text-base font-extrabold text-white transition hover:bg-[var(--color-whatsapp-hover)]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.436 3 12c0 1.605.498 3.093 1.348 4.31l-1.373 3.513a.563.563 0 0 0 .717.717l3.513-1.373A8.932 8.932 0 0 0 12 20.252Zm0-13.5c4.142 0 7.5 3.023 7.5 6.75s-3.358 6.75-7.5 6.75A7.47 7.47 0 0 1 6.55 19.3l-2.036.796.796-2.036A7.47 7.47 0 0 1 4.5 12c0-3.727 3.358-6.75 7.5-6.759Z" />
            </svg>
            {landingContent.cta.detailLabel}
          </a>
        </div>

        <div class="mt-6 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-soft)] p-4">
          <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-[var(--color-brand-soft)]">Otras zonas de atencion</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {otherZones.map((item) => (
              <li>
                <a
                  href={`/zona/${item.slug}`}
                  class="inline-block rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1.5 text-xs font-semibold text-[var(--color-text)] transition hover:border-[var(--color-brand-soft)]"
                >
                  {item.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Footer
    brandName={landingContent.brand.name}
    businessLabel={landingContent.footer.businessLabel}
    phoneLabel={landingContent.contact.phoneLabel}
    addressReference={landingContent.footer.addressReference}
    coverageLabel={landingContent.footer.coverageLabel}
    serviceConditions={landingContent.legal.serviceConditions}
    commercialNotice={landingContent.legal.commercialNotice}
  />
  <FloatingWhatsapp whatsappUrl={zoneWhatsappUrl} />
  <MobileActionBar whatsappUrl={zoneWhatsappUrl} whatsappLabel={landingContent.cta.mobileLabel} />
</BaseLayout>
